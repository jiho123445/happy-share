rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public website data is readable by visitors.
    // All writes require the Firebase Authentication user to be the configured admin UID.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'a1MQmdMGkgdorEl6V3FAptCAYo52';
    }

    match /foundation/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Test collection is disabled in production.
    match /test/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

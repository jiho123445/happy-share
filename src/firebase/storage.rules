rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'a1MQmdMGkgdorEl6V3FAptCAYo52';
    }

    // Image uploads: one file <= 10 MB. The extension check is intentional:
    // MIME type alone is not sufficient because browsers can report generic
    // types for some files. Client-side validation is also performed, but
    // these Storage Rules are the final server-side security boundary.
    match /activities/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg', 'image/png', 'image/webp'
        ]
        && request.resource.name.matches('.*\\.(jpg|JPG|jpeg|JPEG|png|PNG|webp|WEBP)$');
      allow delete: if isAdmin();
    }

    // Notice attachments: one file <= 25 MB. HWP/HWPX are included for
    // Korean office documents; image attachments are also supported.
    match /notices/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'application/haansofthwp',
          'application/vnd.hancom.hwp',
          'application/vnd.hancom.hwpx',
          'application/octet-stream',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.ms-excel',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'application/vnd.ms-powerpoint',
          'application/vnd.openxmlformats-officedocument.presentationml.presentation',
          'image/jpeg', 'image/png', 'image/webp', 'image/gif'
        ]
        && request.resource.name.matches('.*\\.(pdf|PDF|hwp|HWP|hwpx|HWPX|doc|DOC|docx|DOCX|xls|XLS|xlsx|XLSX|ppt|PPT|pptx|PPTX|jpg|JPG|jpeg|JPEG|png|PNG|webp|WEBP|gif|GIF)$');
      allow delete: if isAdmin();
    }

    match /settings/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg', 'image/png', 'image/webp'
        ]
        && request.resource.name.matches('.*\\.(jpg|JPG|jpeg|JPEG|png|PNG|webp|WEBP)$');
      allow delete: if isAdmin();
    }

  }
}
